# Mandatory safety controls. The runtime refuses to start with other values.
AGENT_MODE=paper
MARKET_PROVIDER=okx
ALLOW_REAL_ORDERS=false

# Completely separate v4 runtime databases on Oracle.
MARKET_DB_PATH=/home/ubuntu/crypto-agent-v4-data/market_data.db
PAPER_DB_PATH=/home/ubuntu/crypto-agent-v4-data/paper_v7_forward.db

# Use a separate Telegram bot/chat for this experimental system.
# Put real values only in .env.v4 on Oracle; never commit that file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
