[Unit]
Description=Crypto Agent T12 high-risk forward-only paper cycle
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/crypto-agent-v4
Environment=PYTHONPATH=/home/ubuntu/crypto-agent-v4
Environment=T12_ENV_FILE=/home/ubuntu/crypto-agent-v4/.env.t12-forward
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/ubuntu/crypto-agent-v4/.venv/bin/python -m paper_v4.aggressive_forward_runner
TimeoutStartSec=240
Nice=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/crypto-agent-v4-data
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
